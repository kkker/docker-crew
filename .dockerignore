# 1. 虛擬環境與套件目錄（最重要，避免跨平台衝突）
.venv/
venv/
ENV/
env/

# 2. uv 專案快取與工作目錄
.uv/

# 3. Python 編譯暫存與快取
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipych_cache/

# 4. 敏感資訊與環境變數檔案
.env
.env.*
!.env.example
*.pem
*.key

# 5. Git 與版本控制（通常不需包進運行中的 Container）
.git/
.gitignore
.gitattributes

# 6. 作業系統產生的垃圾檔案
.DS_Store
Thumbs.db

# 7. 專案說明與 IDE 設定（非執行必要檔案）
.vscode/
.idea/
